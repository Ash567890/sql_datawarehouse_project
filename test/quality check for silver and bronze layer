select * from bronze.crm_prd_info;

select count(*), prd_id
from silver.crm_prd_info
group by prd_id
having count(*) > 1 or prd_id is null;

select prd_nm from silver.crm_prd_info
where prd_nm ! = TRIM(prd_nm);

select prd_cost from silver.crm_prd_info
where prd_cost < 0 or prd_cost is null ;

select 
REPLACE(SUBSTRING(prd_key,1, CHARINDEX('-', prd_key, CHARINDEX('-', prd_key) + 1 )-1),'-','_') prd_key 
from bronze.crm_prd_info
where REPLACE(SUBSTRING(prd_key,1, CHARINDEX('-', prd_key, CHARINDEX('-', prd_key) + 1 )-1),'-','_')
not in 
(select distinct id from bronze.erp_px_cat_g1v2);

select distinct prd_line from bronze.crm_prd_info;

select prd_start_dt, prd_end_dt from bronze.crm_prd_info
where prd_start_dt > prd_end_dt;

select prd_start_dt, prd_end_dt from silver.crm_prd_info
where prd_end_dt < prd_start_dt;

select prd_start_dt, prd_end_dt,
dateadd(day, -1, lead(prd_start_dt) over (partition by prd_key order by prd_start_dt))
from bronze.crm_prd_info;

