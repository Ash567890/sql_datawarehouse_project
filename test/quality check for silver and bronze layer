select sls_ord_num from bronze.crm_sales_details
where sls_ord_num != TRIM(sls_ord_num);

select * from bronze.crm_sales_details
--where sls_prd_key not in (select prd_key from silver.crm_prd_info)
where sls_cust_id not in (select cst_id from silver.crm_cust_info);

select sls_order_dt from bronze.crm_sales_details
where sls_order_dt = 0;

select sls_order_dt from bronze.crm_sales_details
where len(sls_order_dt) != 8;

select sls_order_dt from bronze.crm_sales_details
where len(sls_ship_dt) != 8; --- correct

select sls_order_dt from bronze.crm_sales_details
where sls_ship_dt = 0 or sls_ship_dt is null;

select * from bronze.crm_sales_details
where sls_sales != sls_quantity * sls_price;


select sls_sales,
case 
	when sls_sales is null or sls_sales <= 0 or sls_sales != sls_quantity * abs(sls_price)
	then sls_quantity * ABS(sls_price)
	else sls_sales
end sls_sales1,
sls_price,
sls_quantity,
Case 
	when sls_price is null or sls_price <= 0
	then abs(sls_sales)/nullif(sls_quantity,0)
	else sls_price
end sls_price1
from bronze.crm_sales_details
where sls_sales is null or sls_sales <= 0 or sls_sales != sls_quantity * abs(sls_price)
or sls_price <= 0 or sls_price is null

select * from silver.crm_sales_details
where sls_order_dt > sls_ship_dt or sls_order_dt > sls_due_dt;

select sls_sales,
sls_price,
sls_quantity
from silver.crm_sales_details
where sls_sales is null or sls_sales <= 0 or sls_sales != sls_quantity * abs(sls_price)
or sls_price <= 0 or sls_price is null

